# ==============================================================================
# MindBloom AI - Firebase Authentication Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' or '.env.local' in the project root:
#      cp .env.example .env.local
# 2. Go to the Firebase Console: https://console.firebase.google.com/
# 3. Create or select your project.
# 4. Under Project Settings > General > Your apps, select your Web App (</>).
# 5. Copy the configuration keys and replace the placeholder values below.
# 6. Ensure 'Email/Password' and 'Google' are enabled in Firebase Console > Authentication > Sign-in method.
# 7. Ensure 'localhost' is listed under Authentication > Settings > Authorized domains.
# ==============================================================================

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHerePlaceholder12345
VITE_FIREBASE_AUTH_DOMAIN=mindbloom-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mindbloom-app
VITE_FIREBASE_STORAGE_BUCKET=mindbloom-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234
